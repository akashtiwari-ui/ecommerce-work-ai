# Canonical production origin — used for canonical URLs, sitemap, JSON-LD, llms.txt and feeds.
# Change this (and redeploy) when you move to a custom domain.
NEXT_PUBLIC_SITE_URL=https://wallers.vercel.app

# Google Search Console → Add property → URL prefix → HTML tag → paste only the content="..." value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML Meta Tag → paste only the content="..." value
NEXT_PUBLIC_BING_SITE_VERIFICATION=
